rules_version = '2';

// Security rules for Line Learner. Paste into Firebase: Databases and storage > Firestore > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // The app's admin (Shannon). Must match ADMIN_UID in admin.js.
    function isAdmin() { return signedIn() && request.auth.uid == 'tEUc6ZFsyENufRbOSoVtCaF7sV62'; }
    // Blocked people can't use groups, sharing or the shared voices.
    function notBlocked() { return !exists(/databases/$(database)/documents/blocked/$(request.auth.uid)); }
    function memberOf(gid) {
      return signedIn() && notBlocked() && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // A group's directors (chosen by its creator): they see the cast's progress and set at-home rehearsals.
    function directorOf(gid) {
      return memberOf(gid) && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.get('directors', []);
    }

    // Each person's own synced scripts: only they can read or write them. The admin can see and delete
    // them (to remove someone's data).
    match /users/{uid}/{rest=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read, delete: if isAdmin();
    }

    // Name, email and last seen, so the admin knows who uses the app.
    match /profiles/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Rehearsal reminders: the next sessions of your rehearsal plan, for the reminders server (the voices Worker,
    // which reads them with its own Google credentials) to send to your devices. Only you can see or change
    // yours, and each one's ID starts with your account ID so no one can write over someone else's.
    match /reminders/{id} {
      allow read, delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && id.matches(request.auth.uid + '_[A-Za-z0-9]{1,40}')
        && request.resource.data.keys().hasOnly(['uid', 'at', 'url', 'title', 'body'])
        && request.resource.data.at is int
        && request.resource.data.url is string && request.resource.data.url.size() <= 40
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.body is string && request.resource.data.body.size() <= 300;
    }

    // People the admin has blocked. They can see that they're blocked; only the admin can change it.
    match /blocked/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list, write: if isAdmin();
    }

    // Send feedback: anyone can send a note (signed in or not); only the admin can read or delete them.
    // (The voices server reads a new note with its own Google credentials to email it to the admin.)
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'message', 'contact', 'details', 'screenshot', 'at', 'uid', 'name'])
        && request.resource.data.kind in ['bug', 'idea', 'copyright', 'privacy', 'other']
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 200
        && request.resource.data.details is string && request.resource.data.details.size() <= 6000
        && (!('screenshot' in request.resource.data) || (request.resource.data.screenshot is string && request.resource.data.screenshot.size() <= 900000
          && request.resource.data.screenshot.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$')))
        && (!('uid' in request.resource.data) || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read, delete: if isAdmin();
    }

    // Invite codes point to a group. They can be looked up one at a time (to join) but never listed.
    match /invites/{code} {
      allow get: if (signedIn() && notBlocked()) || isAdmin();
      // Created together with its group, by that group's creator.
      allow create: if signedIn() && notBlocked()
        && request.auth.uid in getAfter(/databases/$(database)/documents/groups/$(request.resource.data.gid)).data.members;
      allow delete: if isAdmin();
    }

    match /groups/{gid} {
      allow read: if (signedIn() && notBlocked() && request.auth.uid in resource.data.members) || isAdmin();
      allow create: if signedIn() && notBlocked()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if isAdmin() || (signedIn() && (
        // Leaving: you can take yourself off the member list, and no one else.
        (request.auth.uid in resource.data.members
          && changed().hasOnly(['members'])
          && resource.data.members.toSet().difference(request.resource.data.members.toSet()) == [request.auth.uid].toSet()
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0)
        // Joining (or rejoining): only by showing the invite code, adding only yourself and your own name.
        || (notBlocked()
          && changed().hasOnly(['members', 'memberNames', 'lastJoinCode'])
          && request.resource.data.lastJoinCode == resource.data.inviteCode
          && request.resource.data.members.toSet().hasAll(resource.data.members.toSet())
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).hasOnly([request.auth.uid])
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid]))
        // Renaming, and choosing directors (from the members): the group's creator only.
        || (resource.data.ownerUid == request.auth.uid && changed().hasOnly(['name', 'directors'])
          && request.resource.data.get('directors', []) is list
          && resource.data.members.toSet().hasAll(request.resource.data.get('directors', []).toSet()))
      ));
      // Only the admin can delete a group, so no one else can make shared scripts disappear that way.
      allow delete: if isAdmin();

      // Shared scripts and songs: members can see them; only the person who shared one can change it.
      // Failsafes: an update must keep the version it replaces (prevRaw), so the admin can undo it;
      // "Unshare" only marks it removed; and only the admin can delete one for good.
      match /items/{itemId} {
        function validItem(d) {
          return d.keys().hasOnly(['id', 'title', 'raw', 'kind', 'updated', 'addedBy', 'addedByName', 'song', 'prevRaw', 'prevTitle', 'prevUpdated', 'removed', 'licenseEnds', 'permission', 'inactive'])
            && (!('licenseEnds' in d) || (d.licenseEnds is string && d.licenseEnds.size() <= 10))
            && (!('inactive' in d) || d.inactive is bool)
            && d.title is string && d.title.size() <= 300
            && d.raw is string && d.raw.size() <= 450000
            && d.kind in ['script', 'song']
            && d.addedByName is string && d.addedByName.size() <= 100
            && (!('prevRaw' in d) || (d.prevRaw is string && d.prevRaw.size() <= 450000));
        }
        allow read: if memberOf(gid) || isAdmin();
        // Songs only when the sharer confirms the lyrics are public domain.
        allow create: if memberOf(gid) && request.resource.data.addedBy == request.auth.uid
          && validItem(request.resource.data) && !('removed' in request.resource.data)
          && (request.resource.data.kind != 'song' || request.resource.data.get('permission', false) == 'public-domain');
        allow update: if isAdmin() || (memberOf(gid)
          && resource.data.addedBy == request.auth.uid
          && request.resource.data.addedBy == request.auth.uid
          && validItem(request.resource.data)
          && (request.resource.data.raw == resource.data.raw || request.resource.data.get('prevRaw', null) == resource.data.raw)
          && (request.resource.data.kind != 'song' || request.resource.data.raw == resource.data.raw
            || request.resource.data.get('permission', false) == 'public-domain'));
        allow delete: if isAdmin();
      }

      // Each member's practice summary for this group's scripts. Only they write it; only they and the
      // group's directors can read it. Leaving the group (or the admin) deletes it.
      match /progress/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || directorOf(gid) || isAdmin();
        allow create, update: if memberOf(gid) && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'updated', 'optOut', 'items', 'done'])
          && request.resource.data.uid == uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && (!('items' in request.resource.data) || request.resource.data.items is map)
          && (!('done' in request.resource.data) || request.resource.data.done is map)
          && (!('optOut' in request.resource.data) || request.resource.data.optOut is bool);
        allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
      }

      // At-home rehearsals: directors set them, the whole group sees them.
      match /assignments/{aid} {
        allow read: if memberOf(gid) || isAdmin();
        allow create, update: if directorOf(gid)
          && request.resource.data.keys().hasOnly(['itemId', 'itemTitle', 'scene', 'mode', 'due', 'note', 'for', 'by', 'byName', 'created', 'updated'])
          && request.resource.data.mode in ['rehearse', 'listen', 'drill', 'type']
          && request.resource.data.itemId is string && request.resource.data.itemId.size() <= 60
          && request.resource.data.itemTitle is string && request.resource.data.itemTitle.size() <= 300
          && request.resource.data.scene is string && request.resource.data.scene.size() <= 300
          && request.resource.data.due is string && request.resource.data.due.size() <= 10
          && request.resource.data.note is string && request.resource.data.note.size() <= 500
          && request.resource.data['for'] is list && request.resource.data['for'].size() <= 300
          && request.resource.data.byName is string && request.resource.data.byName.size() <= 100;
        allow delete: if directorOf(gid) || isAdmin();
      }
    }
  }
}
